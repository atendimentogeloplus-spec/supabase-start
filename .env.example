# Copie para .env e ajuste se necessario.
# Porta HTTP unica exposta pelo servidor (frontend + API juntos).
PORT=3000

# Caminho do arquivo SQLite (relativo a raiz do projeto ou absoluto).
DB_PATH=./data/leadtrack.db

# Segredo usado para assinar o cookie de sessao. Troque em producao.
SESSION_SECRET=troque-este-segredo-em-producao

# Credenciais do admin criado na primeira inicializacao.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@leadtrack.local
SEED_ADMIN_PASSWORD=admin123
